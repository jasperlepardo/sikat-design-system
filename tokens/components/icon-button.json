{
  "$component": {
    "name": "IconButton",
    "className": "sikat-icon-btn",
    "prefix": "icon-btn",
    "element": "button",
    "colorAxes": [
      "intent",
      "style"
    ],
    "sizeAxis": "size",
    "states": [
      "rest",
      "hover",
      "disabled"
    ],
    "interactive": true,
    "slots": {},
    "base": {
      "display": "inline-flex",
      "align-items": "center",
      "justify-content": "center",
      "box-sizing": "border-box",
      "width": "--icon-btn-box",
      "height": "--icon-btn-box",
      "border": "none",
      "border-radius": "--icon-btn-radius",
      "background-color": "--icon-btn-bg",
      "color": "--icon-btn-icon",
      "cursor": "pointer",
      "transition": "background-color 120ms ease, box-shadow 120ms ease, color 120ms ease",
      "box-shadow": "inset 0 0 0 var(--border-width-1) var(--icon-btn-border)"
    },
    "stateSelectors": {
      "rest": "",
      "hover": ":is(:hover, [data-state=\"hover\"]):not(:disabled):not([aria-disabled=\"true\"])",
      "disabled": ":disabled"
    }
  },
